{
  "name": "@kiket/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:submodules": "node scripts/sync-submodule-readmes.mjs",
    "prebuild": "node scripts/sync-submodule-readmes.mjs && fumadocs-mdx",
    "postinstall": "fumadocs-mdx",
    "dev": "next dev -p 3001",
